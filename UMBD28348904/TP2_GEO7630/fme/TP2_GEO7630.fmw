# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Dissolver_Area_60538cf6_add1_4692_8373_6ae0b02e5a2c6} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Dissolver_Area
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Dissolver_Area_Logger }    INPUT  FEATURE_TYPE Dissolver_AREA    OUTPUT { FEATURE_TYPE Dissolver_Area_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { AttributeManager }    INPUT  FEATURE_TYPE Dissolver_Area_LOGGED    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "ID" "ID" "" "number<openparen>11<comma>0<closeparen>" "NO_OP" }      ATTR_ACTION { "TOPONYME" "TOPONYME" "" "varchar<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "EQM" "EQM" "" "varchar<openparen>40<closeparen>" "NO_OP" }      ATTR_ACTION { "SOURCE" "SOURCE" "" "varchar<openparen>30<closeparen>" "REMOVE" }      ATTR_ACTION { "TRAITEMENT" "TRAITEMENT" "" "varchar<openparen>30<closeparen>" "NO_OP" }      ATTR_ACTION { "DIFFUSEUR" "DIFFUSEUR" "" "varchar<openparen>50<closeparen>" "REMOVE" }      ATTR_ACTION { "VERSION" "VERSION" "" "int32" "REMOVE" }      ATTR_ACTION { "NOM" "NOM" "" "varchar<openparen>50<closeparen>" "REMOVE" }      ATTR_ACTION { "type_dv" "type_dv" "" "int32" "REMOVE" }      ATTR_ACTION { "cons_cl_dv" "cons_cl_dv" "" "int32" "REMOVE" }      ATTR_ACTION { "id_ce" "id_ce" "" "real64" "REMOVE" }      ATTR_ACTION { "Shape__Len" "Shape__Len" "" "real64" "REMOVE" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_OUTPUT        }
