# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {PenteValeur_existante_97aeef2a_083b_4b97_a9d6_7d5a48ce7dba6} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME PenteValeur_existante
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { PenteValeur_existante_Logger }    INPUT  FEATURE_TYPE AttributeFilter_2_<lt>UNFILTERED<gt>    OUTPUT { FEATURE_TYPE PenteValeur_existante_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature<space>is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_2 }    INPUT  FEATURE_TYPE PenteValeur_existante_LOGGED    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>pente<closeparen>,Tester_2)" = 1 ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>pente<closeparen>,Tester_2)" = 2 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_2_PASSED         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AreaBuilder_2_router1 }    INPUT  FEATURE_TYPE Tester_2_PASSED    OUTPUT { FEATURE_TYPE AreaBuilder_2___ValidGeoms___ }
INCLUDE [if { ("NONE" == "NONE") || ("<Unused>" == "0") } {              puts "MACRO AreaBuilder_2_IS_ENABLE NOT_THIS_TIME";          } else {              puts "MACRO AreaBuilder_2_IS_ENABLE *";          }          ]
# We skip this step if tolerance is 0
FACTORY_DEF {$(AreaBuilder_2_IS_ENABLE)} SnappingFactory    FACTORY_NAME { AreaBuilder_2_SNAPPER }    INPUT { FEATURE_TYPE AreaBuilder_2___ValidGeoms___ }    WARN_ON_COORD_SYS_MISMATCH NO    SNAP_TYPE { NONE }    SNAP_TOLERANCE { <Unused> }    EXTEND_LINES_TO_SNAP NEVER    SAVE_SHORT_LINES No    OUTPUT { SNAPPED FEATURE_TYPE AreaBuilder_2___ValidGeoms___ }    OUTPUT { UNTOUCHED FEATURE_TYPE AreaBuilder_2___ValidGeoms___ }
FACTORY_DEF {*} PolygonFactory    FACTORY_NAME { AreaBuilder_2_polygonizer }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT { FEATURE_TYPE AreaBuilder_2___ValidGeoms___ }    CONSIDER_NODE_ELEVATION { NO }    CONNECT_Z_MODE { FIRST_WINS }    END_NODED    REPORT_PROGRESS    LIST_ATTRS_TO_INCLUDE  { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    DIRECTION_NAME { "<Unused>" }    LINES_AS_SEGMENTS { No }    ALLOW_CYCLES { No }    REJECT_INVALID_GEOM Yes    DEAGGREGATE_INPUT { Deaggregate }    ACCUMMULATE_ATTRIBUTES { One }    OUTPUT { POLYGON FEATURE_TYPE ___POLY___ }    OUTPUT { REJECTED FEATURE_TYPE AreaBuilder_2_<REJECTED>         }
INCLUDE [ if { ("Yes" == "Yes") || ("Yes" == "yes") || ("Yes" == "YES") } {              puts "MACRO DONUT_FACTORY_IN *";              puts "MACRO TEE_FACTORY_IN NOT_THIS_TIME";          } else {              puts "MACRO DONUT_FACTORY_IN NOT_THIS_TIME";              puts "MACRO TEE_FACTORY_IN *";          }          ]
FACTORY_DEF {$(DONUT_FACTORY_IN)} DonutFactory    FACTORY_NAME { AreaBuilder_2_donutizer }    WARN_ON_COORD_SYS_MISMATCH NO    INPUT FEATURE_TYPE ___POLY___    CONNECT_Z_MODE { FIRST_WINS }    LINES_AS_SEGMENTS { No }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    DROP_HOLES { No }    TAG_HOLES NO    SPLIT_INPUT_DONUTS    AREA_BUILDER_HELPER_MODE    MERGE_INCOMING_ATTR { YES }    ATTR_ACCUM_MODE { "One" }    LIST_ATTRS_TO_INCLUDE  { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MODE COMPLETE    OUTPUT { DONUT FEATURE_TYPE AreaBuilder_2_AREA        @RemoveAttributes(tagged_hole)         }    OUTPUT { POLYGON FEATURE_TYPE AreaBuilder_2_AREA        @RemoveAttributes(tagged_hole)         }    OUTPUT { REJECTED FEATURE_TYPE AreaBuilder_2_AREA        @RemoveAttributes(fme_rejection_code)         }
FACTORY_DEF {$(TEE_FACTORY_IN)} TeeFactory    FACTORY_NAME { AreaBuilder_2_router2 }    INPUT FEATURE_TYPE ___POLY___    OUTPUT { FEATURE_TYPE AreaBuilder_2_AREA         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME AreaBuilder_2_<Rejected> INPUT FEATURE_TYPE AreaBuilder_2_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, AreaBuilder_2<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
