GUI CHOICE XML_IN_CONTINUE_ON_GEOM_ERROR_XML_1 yes%no Continue on Geometry Error:
DEFAULT_MACRO XML_IN_READER_SETTINGS_XML_1 
GUI OPTIONAL DISCLOSUREGROUP XML_IN_READER_SETTINGS_XML_1 XML_IN_VALIDATE_XFMAP_XML_1%XML_IN_VALIDATE_DATASET_XML_1%XML_IN_IGNORE_DATASET_EXTERNAL_DTD_XML_1%XML_IN_DISABLE_EXTERNAL_ENTITY_PROCESSING_XML_1%XML_IN_CREATE_ENTITY_RESOLVER_XML_1 General
# ============================================================================
