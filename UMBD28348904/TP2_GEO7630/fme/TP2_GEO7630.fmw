Tcl2 proc EsriReprojector_CoordSysRemover {} {   global FME_CoordSys;   global EsriReprojector_CSWarned;   if { ( $FME_CoordSys != {} ) } {     incr EsriReprojector_CSWarned;     if { [set EsriReprojector_CSWarned] <= 1 } {       FME_LogMessage fme_warn \"EsriReprojector: Ignoring input feature coordinate system `$FME_CoordSys'. This warning will not be repeated.\";     };   };   set FME_CoordSys {}; }
