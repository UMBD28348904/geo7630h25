FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE SHAPEFILE SHAPEFILE_1::affectationpu multi_reader_keyword,$(DATASET_KEYWORD_SHAPEFILE_1) TO FME_GENERIC ::affectationpu ALIAS_GEOMETRY    ROUTE SHAPEFILE SHAPEFILE_2::CARTO_DRA_EAU_JOUR multi_reader_keyword,$(DATASET_KEYWORD_SHAPEFILE_2) TO FME_GENERIC ::CARTO_DRA_EAU_JOUR ALIAS_GEOMETRY    ROUTE SHAPEFILE SHAPEFILE_3::PRMHH_CoursEau_Fosses multi_reader_keyword,$(DATASET_KEYWORD_SHAPEFILE_3) TO FME_GENERIC ::PRMHH_CoursEau_Fosses ALIAS_GEOMETRY    ROUTE GML GML_1::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_1) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_6::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_6) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_9::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_9) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_11::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_11) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_2::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_2) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_3::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_3) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    ROUTE GML GML_4::TINRelief multi_reader_keyword,$(DATASET_KEYWORD_GML_4) TO FME_GENERIC ::TINRelief ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
SHAPEFILE_1_MERGE_DEF SHAPEFILE_1::affectationpu EXACT affectationpu
SHAPEFILE_2_MERGE_DEF SHAPEFILE_2::CARTO_DRA_EAU_JOUR EXACT CARTO_DRA_EAU_JOUR
SHAPEFILE_3_MERGE_DEF SHAPEFILE_3::PRMHH_CoursEau_Fosses EXACT PRMHH_CoursEau_Fosses
