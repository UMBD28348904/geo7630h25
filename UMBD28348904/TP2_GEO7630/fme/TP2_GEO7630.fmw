GUI OPTIONAL DYNAMIC_MULTI_SELECT_ENCODED XML_IN_XFMAP_FEATURE_PATHS_XML_1 $[SourceDataset_XML_1],_GET_ATTRIBUTE_VALUES_,,XML_PATH_SCAN,YES,NETWORK_AUTHENTICATION,$[XML_IN_NETWORK_AUTHENTICATION_XML_1],FME_DELIM,<space>,FME_PARENT_SELECTION,root_node,FME_READ_SCHEMA,NO,FME_DN_ATTR,display_value,FME_PATH_ATTR,feature_path,IGNORE_DATASET_EXTERNAL_DTD,$[XML_IN_IGNORE_DATASET_EXTERNAL_DTD_XML_1],DISABLE_EXTERNAL_ENTITY_PROCESSING,$[XML_IN_DISABLE_EXTERNAL_ENTITY_PROCESSING_XML_1],CREATE_ENTITY_RESOLVER,$[XML_IN_CREATE_ENTITY_RESOLVER_XML_1],_FORMAT_OVERRIDE_,XML Elements to Match:
# =================================================================
DEFAULT_MACRO XML_IN_XFMAP_FEATURE_PATHS_EXCEPT_XML_1 
XML_1_XFMAP_FEATURE_PATHS_EXCEPT "$(XML_IN_XFMAP_FEATURE_PATHS_EXCEPT_XML_1)"
DEFAULT_MACRO XML_IN_FME_GROUP_NAMED3_XML_1 
GUI OPTIONAL DISCLOSUREGROUP XML_IN_FME_GROUP_NAMED3_XML_1 XML_IN_XFMAP_FEATURE_PATHS_SUB_FRAGMENTS%XML_IN_XFMAP_FEATURE_PATHS_STRUCTURE_XML_1 Customize Attributes
# =================================================================
# NOTE: Any changes made should be made to XMLFlattener, XMLFragmenter and XML Reader metafile
GUI LOOKUP XML_IN_XFMAP_FEATURE_PATHS_STRUCTURE_XML_1 <Unused>, 
DEFAULT_MACRO XML_IN_XFMAP_FEATURE_PATHS_STRUCTURE_XML_1 <lt>structure<space><space><lf>separator=<quote>.<quote><space><lf>map-empty-elements=<quote>yes<quote><space><lf>matched-prefix=<quote>attributes<quote><space><lf>matched-attributes=<quote>yes<quote><space><lf>cardinality=<quote>+<opencurly>?<closecurly><quote><lf>except-expression=<quote><quote><lf>structure-prefix=<quote><quote><lf>child-position-attribute=<quote><quote><lf>attribute-identifier=<quote><quote><lf>ui-mode=<quote>basic<quote><solidus><gt>
XML_1_XFMAP_FEATURE_PATHS_STRUCTURE "$(XML_IN_XFMAP_FEATURE_PATHS_STRUCTURE_XML_1)"
GUI OPTIONAL XML_FLATTEN_OPTIONS XML_IN_XFMAP_FEATURE_PATHS_STRUCTURE_XML_1 Flatten Options:
# =================================================================
# NOTE: Any changes made should be made to XMLFlattener, XMLFragmenter and XML Reader metafile
DEFAULT_MACRO XML_IN_XFMAP_FEATURE_PATHS_SUB_FRAGMENTS_XML_1 
XML_1_XFMAP_FEATURE_PATHS_SUB_FRAGMENTS "$(XML_IN_XFMAP_FEATURE_PATHS_SUB_FRAGMENTS_XML_1)"
DEFAULT_MACRO XML_IN_FME_GROUP_NAMED4_XML_1 
GUI OPTIONAL DISCLOSUREGROUP XML_IN_FME_GROUP_NAMED4_XML_1 XML_IN_XFMAP_XML_1%XML_IN_XRS_XML_1 Other Configurations
# =================================================================
GUI LOOKUP XML_IN_XFMAP_XML_1 <Unused>, 
DEFAULT_MACRO XML_IN_XFMAP_XML_1 
XML_1_XFMAP "$(XML_IN_XFMAP_XML_1)"
GUI OPTIONAL MULTIFILE XML_IN_XFMAP_XML_1 XML_Map_File(*.xmp;*.xml)|*.xmp;*.xml|All_Files(*)|* xfMap File:
# =================================================================
GUI LOOKUP XML_IN_XRS_XML_1 <Unused>, 
DEFAULT_MACRO XML_IN_XRS_XML_1 
XML_1_XRS "$(XML_IN_XRS_XML_1)"
GUI OPTIONAL FILENAME_MUSTEXIST XML_IN_XRS_XML_1 XRS_File(*.xml;*.xrs)|*.xml;*.xrs|All_Files(*)|* XRS File:
DEFAULT_MACRO XML_IN_FME_GROUP_NAMED5_XML_1 
GUI OPTIONAL DISCLOSUREGROUP XML_IN_FME_GROUP_NAMED5_XML_1 XML_IN_CONTINUE_ON_GEOM_ERROR_XML_1 Continue on Geometry Error
# =================================================================
