# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Tester_Passed_4aeaf0ed_ccfb_4c28_ac25_3f38af10817c6} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Tester_Passed
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Tester_Passed_Logger }    INPUT  FEATURE_TYPE Tester_PASSED    OUTPUT { FEATURE_TYPE Tester_Passed_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Tester_Passed LOGGED Splitter"   INPUT FEATURE_TYPE Tester_Passed_LOGGED   OUTPUT FEATURE_TYPE Tester_Passed_LOGGED_0_sUW1fhUvhW8=   OUTPUT FEATURE_TYPE Tester_Passed_LOGGED_1_4WNB16ULKc0=
