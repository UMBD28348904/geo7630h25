# DTD file. If set to 'auto', the xfMap document will only be validated if
# its DTD file is available.
DEFAULT_MACRO XML_IN_VALIDATE_XFMAP_XML_1 no
XML_1_VALIDATE_XFMAP "$(XML_IN_VALIDATE_XFMAP_XML_1)"
GUI CHOICE XML_IN_VALIDATE_XFMAP_XML_1 yes%no%auto Validate XML Map File
# ============================================================================
# This specifies whether the XML dataset should be validated against its
# DTD file. If set to 'auto', the XML document will only be validated if
# its DTD file is available.
DEFAULT_MACRO XML_IN_VALIDATE_DATASET_XML_1 no
XML_1_VALIDATE_DATASET "$(XML_IN_VALIDATE_DATASET_XML_1)"
GUI CHOICE XML_IN_VALIDATE_DATASET_XML_1 yes%no%auto Validate XML Dataset File
# =================================================================
DEFAULT_MACRO XML_IN_IGNORE_DATASET_EXTERNAL_DTD_XML_1 no
XML_1_IGNORE_DATASET_EXTERNAL_DTD "$(XML_IN_IGNORE_DATASET_EXTERNAL_DTD_XML_1)"
GUI CHOICE XML_IN_IGNORE_DATASET_EXTERNAL_DTD_XML_1 yes%no Ignore External DTD:
DEFAULT_MACRO XML_IN_DISABLE_EXTERNAL_ENTITY_PROCESSING_XML_1 yes
XML_1_DISABLE_EXTERNAL_ENTITY_PROCESSING "$(XML_IN_DISABLE_EXTERNAL_ENTITY_PROCESSING_XML_1)"
GUI CHOICE XML_IN_DISABLE_EXTERNAL_ENTITY_PROCESSING_XML_1 yes%no Disable External Entity Processing:
